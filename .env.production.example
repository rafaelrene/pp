# Exact public HTTPS origin. Shoo derives the login callback from this URL.
ORIGIN=https://plans.rafr.dev

# Generate with: openssl rand -base64 32
SESSION_SECRET=

# SQLite must remain inside the persistent /data volume.
DATABASE_PATH=/data/pp.sqlite

# Override only when self-hosting Shoo.
SHOO_BASE_URL=https://shoo.dev

# Comma-separated Shoo email addresses allowed to sign in and use API tokens.
ALLOWED_EMAILS=skreciprodukcia@gmail.com

ALLOW_ANONYMOUS_UPLOADS=false

MAX_HTML_BYTES=524288
BODY_SIZE_LIMIT=2M

# LAN address of the app VM, reachable by the Nginx Proxy Manager LXC.
PP_BIND_ADDRESS=192.168.1.50

# Optional per-draft subdomains. Requires matching wildcard DNS and TLS.
# PUBLIC_DRAFT_URL=https://*.plans.example.com
