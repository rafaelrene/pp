{
	"name": "@rraf/pp",
	"version": "0.1.0",
	"description": "Publish an HTML file and get a public URL.",
	"type": "module",
	"bin": {
		"pp": "dist/index.js"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"check": "tsc --noEmit",
		"dev": "tsc -p tsconfig.build.json --pretty false && node dist/index.js",
		"lint": "eslint src test",
		"prepublishOnly": "pnpm check && pnpm lint && pnpm test && pnpm build",
		"test": "vitest run"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^24.10.13",
		"eslint": "^10.8.1",
		"globals": "^17.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.67.0",
		"vitest": "^4.1.10"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rafaelrene/pp.git",
		"directory": "packages/cli"
	},
	"homepage": "https://plans.rafr.dev",
	"bugs": {
		"url": "https://github.com/rafaelrene/pp/issues"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	}
}
