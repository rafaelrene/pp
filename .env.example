# Canonical adapter-node origin and default public URL.
ORIGIN=http://localhost:5173

# Override when public links and auth callbacks use a different origin.
# PUBLIC_BASE_URL=https://pp.example.com

# Optional per-draft subdomains. Requires matching wildcard DNS and TLS.
# PUBLIC_DRAFT_URL=https://*.plans.example.com

# Generate with: openssl rand -base64 32
SESSION_SECRET=replace-me-with-at-least-32-random-characters

# Shoo auto-registers this app from its callback origin. Override only for self-hosting.
SHOO_BASE_URL=https://shoo.dev

# A persistent path is required in production (for example, on a Railway volume).
DATABASE_PATH=./data/pp.sqlite

# Defaults to 524288 (512 KiB).
MAX_HTML_BYTES=524288

# Leaves room for JSON encoding around a maximum-sized HTML file.
BODY_SIZE_LIMIT=2M
